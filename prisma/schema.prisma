generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ORGANIZATION_ADMIN
  FINANCE_MANAGER
  ACCOUNTANT
  PROPERTY_MANAGER
  OPERATIONS
  CLEANER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum BookingPlatform {
  AIRBNB
  BOOKING_COM
  VRBO
  EXPEDIA
  HOTELS_COM
  AGODA
  DIRECT_WEBSITE
  PHONE_BOOKING
  CORPORATE_CLIENT
  TRAVEL_AGENT
  OTHER
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReconciliationStatus {
  UNMATCHED
  PARTIALLY_MATCHED
  MATCHED
  RECONCILED
}

enum TaxClassification {
  ALLOWABLE
  DISALLOWABLE
  PARTIALLY_ALLOWABLE
  CAPITAL
  FINANCE_COST
  UNKNOWN
  ACCOUNTANT_REVIEW
}

enum VatTreatment {
  STANDARD
  REDUCED
  ZERO
  EXEMPT
  OUTSIDE_SCOPE
  REVERSE_CHARGE
  UNKNOWN
}

enum VatRecoverable {
  YES
  NO
  PARTIAL
  UNKNOWN
}

enum ExpenseNature {
  REPAIR
  MAINTENANCE
  IMPROVEMENT
  CAPITAL_EXPENDITURE
  UNKNOWN
  ACCOUNTANT_REVIEW
}

enum AccountingClassification {
  REVENUE_EXPENSE
  REPLACEMENT_DOMESTIC_ITEM
  CAPITAL_ASSET
  UNKNOWN
  ACCOUNTANT_REVIEW
}

enum CostBehaviour {
  VARIABLE
  FIXED
  COMPANY
  NONE
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  DIRECT_DEBIT
  STRIPE
  PAYPAL
  PLATFORM_PAYOUT
  OTHER
}

enum PaymentDirection {
  RECEIVED
  MADE
}

enum BankDirection {
  CREDIT
  DEBIT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum SupplierBillStatus {
  DRAFT
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  VOID
}

enum DepositStatus {
  RECEIVED
  HELD
  RETURNED
  PARTIALLY_RETAINED
  RETAINED
}

enum RefundReason {
  GUEST_CANCELLATION
  COMPLAINT
  CLEANING_ISSUE
  PROPERTY_ISSUE
  HOST_CANCELLATION
  DUPLICATE_PAYMENT
  DAMAGE
  GOODWILL
  OTHER
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  CUSTOM
}

enum DocumentKind {
  CUSTOMER_INVOICE
  SUPPLIER_INVOICE
  RECEIPT
  CONTRACT
  UTILITY_BILL
  BANK_STATEMENT
  INSURANCE
  LICENCE
  COMPLIANCE_CERTIFICATE
  LEASE
  AIRBNB_STATEMENT
  BOOKING_COM_STATEMENT
  TAX_DOCUMENT
  ACCOUNTANT_DOCUMENT
  OTHER
}

enum CategoryGroup {
  INCOME
  EXPENSE
}

// --- Channel management (distribution / connectivity layer) ---
//
// Mira is the canonical source of truth for property, rate, availability and
// reservation data. Every OTA/channel is an adapter around this core — see
// src/domain/channels. These tables deliberately stay separate from the
// existing accounting Booking model: a Reservation is the *operational*
// source event raised by (or sent to) a channel; it is converted into the
// financial Booking/Income/Expense records once confirmed.

enum ChannelProvider {
  DIRECT
  MOCK_AIRBNB
  MOCK_BOOKING_COM
  MOCK_VRBO
}

enum ChannelConnectionStatus {
  AUTHORIZING
  MAPPING_REQUIRED
  ACTIVE
  DEGRADED
  ACTION_REQUIRED
  DISCONNECTED
}

enum ChannelSyncMode {
  FULL_SYNC
  ARI_ONLY
  RESERVATIONS_ONLY
}

enum ReservationStatus {
  INQUIRY
  CONFIRMED
  MODIFIED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

model ChannelAccount {
  id             String                  @id @default(uuid())
  tenantId       String
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  provider       ChannelProvider
  displayName    String
  status         ChannelConnectionStatus @default(AUTHORIZING)
  capabilities   Json
  credentialReference String?
  lastSyncAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  mappings     ListingMapping[]
  reservations Reservation[]
  syncEvents   SyncEvent[]

  @@index([tenantId, organizationId])
  @@map("channel_accounts")
}

model ListingMapping {
  id               String          @id @default(uuid())
  tenantId         String
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  channelAccountId String
  channelAccount   ChannelAccount  @relation(fields: [channelAccountId], references: [id])
  propertyId       String
  property         Property        @relation(fields: [propertyId], references: [id])
  externalListingId String
  syncMode         ChannelSyncMode @default(ARI_ONLY)
  markupBps        Int             @default(0)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([channelAccountId, externalListingId])
  @@index([tenantId, organizationId, propertyId])
  @@map("listing_mappings")
}

model DailyRate {
  id             String   @id @default(uuid())
  tenantId       String
  organizationId String
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])
  date           DateTime @db.Date
  basePricePence Int
  minStay        Int      @default(1)
  stopSell       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([propertyId, date])
  @@index([tenantId, organizationId])
  @@map("daily_rates")
}

model Reservation {
  id                 String             @id @default(uuid())
  tenantId           String
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id])
  propertyId         String
  property           Property           @relation(fields: [propertyId], references: [id])
  channelAccountId   String
  channelAccount     ChannelAccount     @relation(fields: [channelAccountId], references: [id])
  provider           ChannelProvider
  externalReservationId String
  status             ReservationStatus  @default(CONFIRMED)
  guestName          String
  guestEmail         String?
  checkInDate        DateTime           @db.Date
  checkOutDate       DateTime           @db.Date
  nights             Int
  guests             Int
  accommodationPence Int
  cleaningPence      Int                @default(0)
  otherPence         Int                @default(0)
  grossPence         Int
  commissionPence    Int                @default(0)
  currency           String             @default("GBP")
  bookingId          String?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  nightLocks ReservationNightLock[]

  @@unique([organizationId, provider, externalReservationId])
  @@index([tenantId, organizationId, propertyId])
  @@map("reservations")
}

// One row per occupied night per property. The unique constraint on
// (propertyId, date) is the double-booking guard described in the PRD:
// reserving a stay inserts one lock row per night inside a single
// transaction, so a second, overlapping reservation collides on the unique
// index and the whole transaction rolls back atomically instead of silently
// creating two confirmed reservations for the same night.
model ReservationNightLock {
  id            String      @id @default(uuid())
  organizationId String
  propertyId    String
  date          DateTime    @db.Date
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@unique([propertyId, date])
  @@index([organizationId])
  @@map("reservation_night_locks")
}

// Raw inbound event store, keyed for idempotency by (organization, provider,
// externalEventId). A provider resending the same webhook four times must
// still produce one processed outcome.
model SyncEvent {
  id               String         @id @default(uuid())
  tenantId         String
  organizationId   String
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id])
  provider         ChannelProvider
  externalEventId  String
  eventType        String
  payload          Json
  processedAt      DateTime?
  conflict         Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@unique([organizationId, provider, externalEventId])
  @@index([tenantId, organizationId, createdAt])
  @@map("sync_events")
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  organizations Organization[]

  @@map("tenants")
}

model Organization {
  id                      String   @id @default(uuid())
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  legalName               String
  tradingName             String
  slug                    String   @unique
  companyNumber           String?
  vatRegistered           Boolean  @default(false)
  vatNumber               String?
  addressLine1            String
  addressLine2            String?
  addressLine3            String?
  city                    String
  postcode                String
  country                 String   @default("GB")
  timezone                String   @default("Europe/London")
  email                   String
  phone                   String?
  website                 String?
  logoUrl                 String?
  financialYearStartMonth Int
  financialYearStartDay   Int
  currency                String   @default("GBP")
  documentRetentionYears  Int      @default(7)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships        OrganizationMembership[]
  invitations        Invitation[]
  properties         Property[]
  customers          Customer[]
  suppliers          Supplier[]
  incomeCategories   IncomeCategory[]
  expenseCategories  ExpenseCategory[]
  bookings           Booking[]
  incomes            Income[]
  expenses           Expense[]
  invoices           Invoice[]
  supplierBills      SupplierBill[]
  payments           Payment[]
  bankAccounts       BankAccount[]
  payouts            Payout[]
  refunds            Refund[]
  deposits           Deposit[]
  documents          Document[]
  recurringExpenses  RecurringExpense[]
  taxSettings        TaxSetting[]
  vatRates           VatRate[]
  budgets            Budget[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  assets             Asset[]
  channelAccounts    ChannelAccount[]
  listingMappings    ListingMapping[]
  reservations       Reservation[]

  @@index([tenantId])
  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMembership[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Invitation {
  id          String    @id @default(uuid())
  tenantId    String
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  email       String
  role        UserRole
  tokenHash   String    @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, organizationId, email])
  @@map("invitations")
}

model Property {
  id        String   @id @default(uuid())
  tenantId  String
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name      String
  address   String
  city      String
  postcode  String
  bedrooms  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts  PropertyContract[]
  bookings   Booking[]
  incomes    Income[]
  expenses   Expense[]
  documents  Document[]
  budgets    Budget[]
  assets     Asset[]
  deposits   Deposit[]
  refunds    Refund[]
  listingMappings ListingMapping[]
  dailyRates      DailyRate[]
  reservations    Reservation[]

  @@index([tenantId, organizationId])
  @@map("properties")
}

model PropertyContract {
  id              String    @id @default(uuid())
  tenantId        String
  organizationId       String
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id])
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  monthlyRentPence Int
  depositPence    Int
  paymentDay      Int
  leaseStart      DateTime  @db.Date
  leaseEnd        DateTime  @db.Date
  rentReviewOn    DateTime? @db.Date
  createdAt       DateTime  @default(now())

  @@index([tenantId, organizationId])
  @@map("property_contracts")
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name      String
  email     String?
  phone     String?
  companyName String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  invoices Invoice[]
  incomes  Income[]
  refunds  Refund[]
  deposits Deposit[]

  @@index([tenantId, organizationId])
  @@map("customers")
}

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id])
  name          String
  companyName   String?
  email         String?
  phone         String?
  address       String?
  companyNumber String?
  vatNumber     String?
  category      String
  paymentTerms  String?
  notes         String?
  bankCipher    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contracts         PropertyContract[]
  expenses          Expense[]
  bills             SupplierBill[]
  recurringExpenses RecurringExpense[]

  @@index([tenantId, organizationId])
  @@map("suppliers")
}

model IncomeCategory {
  id         String         @id @default(uuid())
  tenantId   String
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  parentId   String?
  parent     IncomeCategory? @relation("IncomeTree", fields: [parentId], references: [id])
  children   IncomeCategory[] @relation("IncomeTree")
  code       String
  name       String
  createdAt  DateTime       @default(now())
  incomes    Income[]

  @@unique([organizationId, code])
  @@index([tenantId, organizationId])
  @@map("income_categories")
}

model ExpenseCategory {
  id                         String          @id @default(uuid())
  tenantId                   String
  organizationId                  String
  organization                    Organization         @relation(fields: [organizationId], references: [id])
  parentId                   String?
  parent                     ExpenseCategory? @relation("ExpenseTree", fields: [parentId], references: [id])
  children                   ExpenseCategory[] @relation("ExpenseTree")
  code                       String
  name                       String
  costBehaviour              CostBehaviour
  defaultTaxClassification   TaxClassification
  defaultExpenseNature       ExpenseNature?
  defaultAccountingClass     AccountingClassification?
  createdAt                  DateTime        @default(now())
  expenses                   Expense[]       @relation("ExpenseCategory")
  subExpenses                Expense[]       @relation("ExpenseSubcategory")
  recurringExpenses          RecurringExpense[]

  @@unique([organizationId, code])
  @@index([tenantId, organizationId])
  @@map("expense_categories")
}

model Booking {
  id                     String               @id @default(uuid())
  tenantId               String
  organizationId              String
  organization                Organization              @relation(fields: [organizationId], references: [id])
  propertyId             String
  property               Property             @relation(fields: [propertyId], references: [id])
  customerId             String
  customer               Customer             @relation(fields: [customerId], references: [id])
  reference              String
  platform               BookingPlatform
  externalBookingId      String
  status                 BookingStatus
  checkInDate            DateTime             @db.Date
  checkOutDate           DateTime             @db.Date
  numberOfNights         Int
  numberOfGuests         Int
  accommodationRevenue   Decimal              @db.Decimal(14, 2)
  cleaningRevenue        Decimal              @db.Decimal(14, 2)
  extraGuestRevenue      Decimal              @db.Decimal(14, 2)
  parkingRevenue         Decimal              @db.Decimal(14, 2)
  otherRevenue           Decimal              @db.Decimal(14, 2)
  grossRevenue           Decimal              @db.Decimal(14, 2)
  platformCommission     Decimal              @db.Decimal(14, 2)
  paymentProcessingFee   Decimal              @db.Decimal(14, 2)
  refunds                Decimal              @db.Decimal(14, 2)
  adjustments            Decimal              @db.Decimal(14, 2)
  netPayout              Decimal              @db.Decimal(14, 2)
  vatAmount              Decimal              @db.Decimal(14, 2)
  currency               String               @default("GBP")
  payoutDate             DateTime?            @db.Date
  reconciliationStatus   ReconciliationStatus @default(UNMATCHED)
  notes                  String?
  createdById            String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  incomes    Income[]
  expenses   Expense[]
  refundsRel Refund[]
  deposits   Deposit[]
  payoutLinks PayoutBooking[]
  documents  Document[]

  @@unique([organizationId, reference])
  @@unique([organizationId, platform, externalBookingId])
  @@index([tenantId, organizationId])
  @@index([propertyId])
  @@map("bookings")
}

model Income {
  id              String           @id @default(uuid())
  tenantId        String
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id])
  propertyId      String?
  property        Property?        @relation(fields: [propertyId], references: [id])
  bookingId       String?
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  categoryId      String
  category        IncomeCategory   @relation(fields: [categoryId], references: [id])
  channel         BookingPlatform?
  grossAmount     Decimal          @db.Decimal(14, 2)
  vatAmount       Decimal          @db.Decimal(14, 2)
  netAmount       Decimal          @db.Decimal(14, 2)
  currency        String           @default("GBP")
  transactionDate DateTime         @db.Date
  serviceDate     DateTime         @db.Date
  paymentDate     DateTime?        @db.Date
  paymentStatus   InvoiceStatus    @default(ISSUED)
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId, organizationId, serviceDate])
  @@index([bookingId])
  @@map("income")
}

model Expense {
  id                    String                    @id @default(uuid())
  tenantId              String
  organizationId             String
  organization               Organization                   @relation(fields: [organizationId], references: [id])
  propertyId            String?
  property              Property?                 @relation(fields: [propertyId], references: [id])
  bookingId             String?
  booking               Booking?                  @relation(fields: [bookingId], references: [id])
  supplierId            String?
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id])
  categoryId            String
  category              ExpenseCategory           @relation("ExpenseCategory", fields: [categoryId], references: [id])
  subcategoryId         String?
  subcategory           ExpenseCategory?          @relation("ExpenseSubcategory", fields: [subcategoryId], references: [id])
  reference             String
  description           String
  invoiceNumber         String?
  transactionDate       DateTime                  @db.Date
  paymentDate           DateTime?                 @db.Date
  netAmount             Decimal                   @db.Decimal(14, 2)
  vatAmount             Decimal                   @db.Decimal(14, 2)
  grossAmount           Decimal                   @db.Decimal(14, 2)
  currency              String                    @default("GBP")
  paymentMethod         PaymentMethod
  taxClassification     TaxClassification
  vatTreatment          VatTreatment
  vatRecoverable        VatRecoverable
  expenseNature         ExpenseNature?
  accountingClass       AccountingClassification?
  isCapitalExpense      Boolean                   @default(false)
  businessPercentage    Decimal                   @db.Decimal(5, 2)
  invoiceUrl            String?
  notes                 String?
  bankTransactionId     String?
  bankTransaction       BankTransaction?          @relation(fields: [bankTransactionId], references: [id])
  recurringExpenseId    String?
  recurringExpense      RecurringExpense?         @relation(fields: [recurringExpenseId], references: [id])
  createdById           String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  payments  Payment[]
  documents Document[]

  @@unique([organizationId, reference])
  @@index([tenantId, organizationId, transactionDate])
  @@index([propertyId])
  @@index([bookingId])
  @@map("expenses")
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  number        String
  status        InvoiceStatus
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  currency      String        @default("GBP")
  netAmount     Decimal       @db.Decimal(14, 2)
  vatAmount     Decimal       @db.Decimal(14, 2)
  grossAmount   Decimal       @db.Decimal(14, 2)
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@unique([organizationId, number])
  @@index([tenantId, organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id          String       @id @default(uuid())
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal      @db.Decimal(10, 2)
  unitAmount  Decimal      @db.Decimal(14, 2)
  vatRateBps  Int
  netAmount   Decimal      @db.Decimal(14, 2)
  vatAmount   Decimal      @db.Decimal(14, 2)
  grossAmount Decimal      @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model SupplierBill {
  id            String             @id @default(uuid())
  tenantId      String
  organizationId     String
  organization       Organization            @relation(fields: [organizationId], references: [id])
  supplierId    String
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  propertyId    String?
  number        String
  status        SupplierBillStatus
  issueDate     DateTime           @db.Date
  dueDate       DateTime           @db.Date
  currency      String             @default("GBP")
  netAmount     Decimal            @db.Decimal(14, 2)
  vatAmount     Decimal            @db.Decimal(14, 2)
  grossAmount   Decimal            @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items    SupplierBillItem[]
  payments Payment[]

  @@unique([organizationId, number])
  @@index([tenantId, organizationId])
  @@map("supplier_bills")
}

model SupplierBillItem {
  id          String       @id @default(uuid())
  billId      String
  bill        SupplierBill @relation(fields: [billId], references: [id])
  description String
  netAmount   Decimal      @db.Decimal(14, 2)
  vatAmount   Decimal      @db.Decimal(14, 2)
  grossAmount Decimal      @db.Decimal(14, 2)

  @@index([billId])
  @@map("supplier_bill_items")
}

model Payment {
  id             String           @id @default(uuid())
  tenantId       String
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id])
  direction      PaymentDirection
  method         PaymentMethod
  amount         Decimal          @db.Decimal(14, 2)
  currency       String           @default("GBP")
  paidOn         DateTime         @db.Date
  reference      String
  invoiceId      String?
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id])
  supplierBillId String?
  supplierBill   SupplierBill?    @relation(fields: [supplierBillId], references: [id])
  expenseId      String?
  expense        Expense?         @relation(fields: [expenseId], references: [id])
  notes          String?
  createdById    String
  createdAt      DateTime         @default(now())

  @@index([tenantId, organizationId])
  @@map("payments")
}

model BankAccount {
  id                   String   @id @default(uuid())
  tenantId             String
  organizationId            String
  organization              Organization  @relation(fields: [organizationId], references: [id])
  bankName             String
  accountName          String
  accountNumberCipher  String
  sortCodeCipher       String
  ibanCipher           String?
  accountNumberLast4   String
  openingBalance       Decimal  @db.Decimal(14, 2)
  createdAt            DateTime @default(now())

  transactions BankTransaction[]

  @@index([tenantId, organizationId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                   String               @id @default(uuid())
  tenantId             String
  organizationId            String
  bankAccountId        String
  bankAccount          BankAccount          @relation(fields: [bankAccountId], references: [id])
  occurredOn           DateTime             @db.Date
  description          String
  amount               Decimal              @db.Decimal(14, 2)
  direction            BankDirection
  reference            String?
  reconciliationStatus ReconciliationStatus @default(UNMATCHED)
  payoutId             String?
  payout               Payout?              @relation(fields: [payoutId], references: [id])
  createdAt            DateTime             @default(now())

  expenses Expense[]

  @@index([tenantId, organizationId, occurredOn])
  @@map("bank_transactions")
}

model Payout {
  id                   String               @id @default(uuid())
  tenantId             String
  organizationId            String
  organization              Organization              @relation(fields: [organizationId], references: [id])
  platform             BookingPlatform
  reference            String
  paidOn               DateTime             @db.Date
  amount               Decimal              @db.Decimal(14, 2)
  reconciliationStatus ReconciliationStatus @default(UNMATCHED)
  createdAt            DateTime             @default(now())

  allocations  PayoutBooking[]
  transactions BankTransaction[]

  @@unique([organizationId, reference])
  @@index([tenantId, organizationId])
  @@map("payouts")
}

model PayoutBooking {
  id        String  @id @default(uuid())
  payoutId  String
  payout    Payout  @relation(fields: [payoutId], references: [id])
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  amount    Decimal @db.Decimal(14, 2)

  @@unique([payoutId, bookingId])
  @@map("payout_bookings")
}

model Refund {
  id         String       @id @default(uuid())
  tenantId   String
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id])
  bookingId  String
  booking    Booking      @relation(fields: [bookingId], references: [id])
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property     @relation(fields: [propertyId], references: [id])
  reference  String
  amount     Decimal      @db.Decimal(14, 2)
  reason     RefundReason
  refundedOn DateTime     @db.Date
  method     PaymentMethod
  platformReference String?
  createdAt  DateTime     @default(now())

  @@index([tenantId, organizationId])
  @@map("refunds")
}

model Deposit {
  id           String        @id @default(uuid())
  tenantId     String
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  bookingId    String?
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id])
  reference    String
  amount       Decimal       @db.Decimal(14, 2)
  retained     Decimal       @db.Decimal(14, 2)
  status       DepositStatus
  receivedOn   DateTime      @db.Date
  createdAt    DateTime      @default(now())

  @@index([tenantId, organizationId])
  @@map("deposits")
}

model Document {
  id          String       @id @default(uuid())
  tenantId    String
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  propertyId  String?
  property    Property?    @relation(fields: [propertyId], references: [id])
  bookingId   String?
  booking     Booking?     @relation(fields: [bookingId], references: [id])
  expenseId   String?
  expense     Expense?     @relation(fields: [expenseId], references: [id])
  kind        DocumentKind
  title       String
  storageKey  String
  mimeType    String
  byteSize    Int
  expiresOn   DateTime?    @db.Date
  createdById String
  createdAt   DateTime     @default(now())

  @@index([tenantId, organizationId])
  @@map("documents")
}

model RecurringExpense {
  id           String              @id @default(uuid())
  tenantId     String
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  propertyId   String?
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  categoryId   String
  category     ExpenseCategory     @relation(fields: [categoryId], references: [id])
  name         String
  amount       Decimal             @db.Decimal(14, 2)
  frequency    RecurrenceFrequency
  nextDueOn    DateTime            @db.Date
  renewalOn    DateTime?           @db.Date
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())

  expenses Expense[]

  @@index([tenantId, organizationId])
  @@map("recurring_expenses")
}

model TaxSetting {
